{
  "manifest_version": 3,
  "name": "AI Prompt Enhancer",
  "version": "1.0.3",
  "description": "Enhances user-written prompts in real-time. Supports a local Ollama install or a user-configured remote Ollama endpoint.",
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16":  "icons/favicon_dark.png",
    "48":  "icons/favicon_dark.png",
    "128": "icons/favicon_dark.png"
  },
  "action": {
    "default_title": "Configure Prompt Enhancer",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/favicon_dark.png",
      "48":  "icons/favicon_dark.png",
      "128": "icons/favicon_dark.png"
    }
  }
}